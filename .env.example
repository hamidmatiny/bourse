OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=2
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
BOURSE_DATABASE_URL=postgresql+psycopg://bourse:bourse@127.0.0.1:55432/bourse
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54317
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# ADR-0047: both aliases equal the single roster model.
BOURSE_MODEL_LARGE=qwen3.5:27b-q4_K_M
BOURSE_MODEL_SMALL=qwen3.5:27b-q4_K_M
BOURSE_ADMIN_TOKEN=
BOURSE_DEV_HOSTS=localhost,127.0.0.1
BOURSE_METER_KEYS=
BOURSE_METER_MAX_TOKENS_PER_CALL=2048
BOURSE_METER_DEADLINE_S=120
# Agent→meter HTTP timeout per LLM call; must be >= METER_DEADLINE_S (ADR-0047).
BOURSE_AGENT_LLM_TIMEOUT_S=180
BOURSE_METER_TEMPERATURE=0
BOURSE_METER_SEED=1234
BOURSE_NUM_CTX_BY_MODEL=qwen3.5:27b-q4_K_M=4096,*=4096
BOURSE_METER_KEEP_ALIVE=30m
BOURSE_TRUST_STRIKES=3
BOURSE_TRUST_WINDOW_S=86400
BOURSE_TASK_MAX_TOKENS=8192
BOURSE_TASK_MAX_CALLS=20
BOURSE_REGISTER_RATE_PER_MIN=10
BOURSE_INLINE_VIOLATIONS_PER_HOUR=20
# Optional: model=seconds from `bourse probe --latency` (max(base, 3*p95)); compose embeds this.
# BOURSE_EXAM_DEADLINE_BY_MODEL=
